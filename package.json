{
  "name": "riftbound",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev -- --host",
    "seed": "cd server && node db/seed.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
